msgid "Monitor Progress"
msgstr "प्रगति पर नज़र रखें"

#: templates/partials/savings_modal.html:605
msgid ""
"The dashboard shows color-coded progress: Green (safe), Yellow (near limit),"
" Red (over budget)."
msgstr ""
