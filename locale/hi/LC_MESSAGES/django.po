#: templates/partials/savings_modal.html:618
msgid "View Budgets"
msgstr "बजट देखें"

#: templates/partials/savings_modal.html:691
msgid "UPCOMING"
msgstr "आगामी"

#: templates/partials/savings_modal.html:736
msgid ""
"Set it once → Transactions are created automatically on the scheduled date"
msgstr "एक बार सेट करें → लेन-देन तय तारीख पर अपने आप बन जाएँगे"

