# Copy to studio/.env (git-ignored). Every key is OPTIONAL — without keys the studio
# uses copy-ready prompts and manual uploads. Keys are read server-side only.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model overrides (names change; check your provider's docs)
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
STUDIO_PORT=8765
